featuresState.InstantSteal = val
end)
CreateToggleButton("Auto TP to Base", featuresState.AutoTPBase, function(val)
featuresState.AutoTPBase = val
end)
CreateToggleButton("Natural Path Movement", featuresState.SafeTween, function(val)
featuresState.SafeTween = val
end)
