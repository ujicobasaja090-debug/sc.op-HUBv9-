local Layout = Instance.new("UIListLayout", Container)
Layout.SortOrder = Enum.SortOrder.LayoutOrder
Layout.Padding = UDim2.new(0, 8)
table.insert(Connections, Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
Container.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y + 10)
end))
local function CreateToggleButton(text, defaultState, callback)
local btn = Instance.new("TextButton", Container)
btn.Size = UDim2.new(1, 0, 0, 40)
btn.Text = "  " .. text
btn.TextColor3 = Color3.fromRGB(220, 220, 220)
btn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
btn.Font = Enum.Font.SourceSansSemibold
btn.TextSize = 14
btn.TextXAlignment = Enum.TextXAlignment.Left
Instance.new("UICorner", btn).CornerRadius = UDim2.new(0, 6)
local StatusInd = Instance.new("Frame", btn)
StatusInd.Size = UDim2.new(0, 40, 0, 20)
StatusInd.Position = UDim2.new(1, -50, 0.5, -10)
StatusInd.BackgroundColor3 = defaultState and Color3.fromRGB(0, 180, 216) or Color3.fromRGB(50, 50, 60)
Instance.new("UICorner", StatusInd).CornerRadius = UDim2.new(0, 10)
local state = defaultState
table.insert(Connections, btn.MouseButton1Click:Connect(function()
state = not state
StatusInd.BackgroundColor3 = state and Color3.fromRGB(0, 180, 216) or Color3.fromRGB(50, 50, 60)
callback(state)
end))
end
local function CreateActionButton(text, callback)
local btn = Instance.new("TextButton", Container)
btn.Size = UDim2.new(1, 0, 0, 40)
btn.Text = text
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.BackgroundColor3 = Color3.fromRGB(0, 119, 182)
btn.Font = Enum.Font.SourceSansBold
btn.TextSize = 14
Instance.new("UICorner", btn).CornerRadius = UDim2.new(0, 6)
table.insert(Connections, btn.MouseButton1Click:Connect(callback))
end
local function CreateDropdown(titleText, optionsList, currentVal, callback)
local frame = Instance.new("Frame", Container)
frame.Size = UDim2.new(1, 0, 0, 40)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
Instance.new("UICorner", frame).CornerRadius = UDim2.new(0, 6)
local label = Instance.new("TextLabel", frame)
label.Size = UDim2.new(0.5, -10, 1, 0)
label.Position = UDim2.new(0, 10, 0, 0)
label.Text = titleText
label.TextColor3 = Color3.fromRGB(200, 200, 200)
label.Font = Enum.Font.SourceSansSemibold
label.TextSize = 13
label.TextXAlignment = Enum.TextXAlignment.Left
label.BackgroundTransparency = 1
local btn = Instance.new("TextButton", frame)
btn.Size = UDim2.new(0.5, -10, 0.8, 0)
btn.Position = UDim2.new(0.5, 0, 0.1, 0)
btn.BackgroundColor3 = Color3.fromRGB(35, 35, 48)
btn.Text = currentVal
btn.TextColor3 = Color3.fromRGB(0, 180, 216)
btn.Font = Enum.Font.SourceSansBold
btn.TextSize = 12
Instance.new("UICorner", btn).CornerRadius = UDim2.new(0, 4)
local currentIndex = 1
for i, v in ipairs(optionsList) do
if v == currentVal then currentIndex = i break end
end
table.insert(Connections, btn.MouseButton1Click:Connect(function()
currentIndex = currentIndex + 1
if currentIndex > #optionsList then
currentIndex = 1
end
local selected = optionsList[currentIndex]
btn.Text = selected
callback(selected)
end))
end
-- ====================================================================
-- [MISI 6] PROXIMITY STEAL & FILTER LOGIC SYSTEM
-- ====================================================================
local function checkItemFilters(prompt)
local actionText = string.lower(prompt.ActionText or "")
local objectText = string.lower(prompt.ObjectText or "")
local parentName = string.lower(prompt.Parent and prompt.Parent.Name or "")
local targetArea = string.lower(featuresState.TargetArea)
local targetRarity = string.lower(featuresState.TargetRarity)
-- 1. Validasi Kata Kunci Steal / Egg
local isStealKeyword = string.find(actionText, "steal") or string.find(actionText, "grab") or string.find(objectText, "steal") or string.find(objectText, "egg") or string.find(parentName, "egg")
if not isStealKeyword then return false end
-- 2. Validasi Filter Area (jika tidak "all areas")
if targetArea ~= "all areas" then
if not string.find(parentName, targetArea) and not string.find(objectText, targetArea) then
return false
end
end
-- 3. Validasi Filter Rarity (jika tidak "all rarities")
if targetRarity ~= "all rarities" then
if not string.find(parentName, targetRarity) and not string.find(objectText, targetRarity) and not string.find(actionText, targetRarity) then
return false
end
end
return true
end
table.insert(Connections, ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt, playerWhoTriggered)
if playerWhoTriggered == LocalPlayer and featuresState.InstantSteal and not isStealing then
if checkItemFilters(prompt) then
if featuresState.AutoTPBase and not savedBaseCFrame then
sendNotification("Peringatan", "Atur Base Location terlebih dahulu!")
return
end
isStealing = true
prompt.HoldDuration = 0
humanDelay(0.15, 0.35)
if fireproximityprompt then
pcall(fireproximityprompt, prompt)
end
task.spawn(function()
local targetPart = resolveStealTarget(prompt.Parent)
local _, root = getCharacter()
if targetPart and root then
local targetPos = targetPart.Position
if (root.Position - targetPos).Magnitude <= LOGICAL_SERVER_CONFIG.SAFE_INTERACT_DIST then
task.wait(0.5)
if StealEvent then
StealEvent:FireServer(targetPart)
end
if featuresState.AutoTPBase and savedBaseCFrame then
humanDelay(0.2, 0.4)
safePhysicalMovement(savedBaseCFrame)
sendNotification("Status", "Proses Curi Selesai -> Kembali ke Base")
end
end
end
task.wait(0.3)
isStealing = false
end)
end
end
end))
local function applyPartLowGraphic(v)
if v:IsA("BasePart") then
if not OriginalGraphics.Parts[v] then
OriginalGraphics.Parts[v] = v.Material
end
v.Material = Enum.Material.SmoothPlastic
elseif v:IsA("Decal") or v:IsA("Texture") then
if not OriginalGraphics.Decals[v] then
OriginalGraphics.Decals[v] = v.Transparency
end
v.Transparency = 1
end
end
local function toggleLowGraphics(state)
featuresState.LowGraphics = state
if state then
for _, v in ipairs(workspace:GetDescendants()) do
applyPartLowGraphic(v)
end
lowGraphicsConnection = workspace.DescendantAdded:Connect(function(v)
if featuresState.LowGraphics then
applyPartLowGraphic(v)
end
end)
sendNotification("Graphics", "Mode Hemat Grafik Aktif")
else
if lowGraphicsConnection then
lowGraphicsConnection:Disconnect()
lowGraphicsConnection = nil
end
for part, mat in pairs(OriginalGraphics.Parts) do
if part and part.Parent then part.Material = mat end
end
for decal, trans in pairs(OriginalGraphics.Decals) do
if decal and decal.Parent then decal.Transparency = trans end
end
table.clear(OriginalGraphics.Parts)
table.clear(OriginalGraphics.Decals)
sendNotification("Graphics", "Grafik Dikembalikan")
end
end
