-- ====================================================================
-- scOP HUB | ULTIMATE MASTER EDITION WITH FILTERS (2026 REFRESH)
-- ====================================================================
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local GuiService = game:GetService("GuiService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local VirtualUser = game:GetService("VirtualUser")
local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Stats = game:GetService("Stats")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
-- ====================================================================
-- [MISI 1] SERVER-SIDE MOCK & REMOTE MANAGEMENT SYSTEM
-- ====================================================================
local StealEvent = ReplicatedStorage:WaitForChild("StealEggEvent", 5)
if RunService:IsServer() then
local MAX_INTERACT_DISTANCE = 14
local COOLDOWN_DELAY = 1.0
local playerCooldowns = {}
local activeProcess = {}
if not StealEvent then
StealEvent = Instance.new("RemoteEvent")
StealEvent.Name = "StealEggEvent"
StealEvent.Parent = ReplicatedStorage
end
StealEvent.OnServerEvent:Connect(function(player, targetEgg)
local character = player.Character
if not character or not character:FindFirstChild("HumanoidRootPart") then return end
local root = character.HumanoidRootPart
local currentTime = os.clock()
if (currentTime - (playerCooldowns[player.UserId] or 0)) < COOLDOWN_DELAY then return end
if not targetEgg or not targetEgg:IsA("BasePart") or not targetEgg:IsDescendantOf(workspace) then return end
if activeProcess[targetEgg] then return end
if (root.Position - targetEgg.Position).Magnitude > MAX_INTERACT_DISTANCE then return end
activeProcess[targetEgg] = true
playerCooldowns[player.UserId] = currentTime
targetEgg:Destroy()
task.delay(0.5, function()
activeProcess[targetEgg] = nil
end)
end)
end
-- ====================================================================
-- [MISI 2] MASTER CLEANUP & STATE GUARD SYSTEM
-- ====================================================================
if getgenv().scOPCleanup then
pcall(getgenv().scOPCleanup)
end
local Connections = {}
local OriginalGraphics = {
Parts = setmetatable({}, {__mode = "k"}),
Decals = setmetatable({}, {__mode = "k"})
}
local UI_TOGGLE_KEY = Enum.KeyCode.RightControl
local isUiVisible = true
local savedBaseCFrame = nil
local lowGraphicsConnection = nil
local isStealing = false
local rejoinAttempts = 0
local LOGICAL_SERVER_CONFIG = {
BASE_SPEED = 18,
SAFE_INTERACT_DIST = 14,
SAFE_COOLDOWN = 0.85
}
local featuresState = {
InstantSteal = false,
AutoTPBase = true,
SafeTween = true,
AutoRejoin = false,
LowGraphics = false,
AntiAFK = false,
TargetArea = "All Areas",
TargetRarity = "All Rarities"
}
-- List Area & Rarity Options untuk Filter
local AreaList = {"All Areas", "Forest", "Lake", "Desert", "Jungle", "Snow", "Volcano", "Abyss Ocean", "Prehistoric", "Cosmic", "Cherry Blossom", "Titan Temple"}
local RarityList = {"All Rarities", "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Cosmic", "Secret", "Eternal", "Divine"}
-- ====================================================================
-- [MISI 3] CORE UTILITIES & HUMANIZED ENGINE SYSTEM
-- ====================================================================
local function getCharacter()
local char = LocalPlayer.Character
if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
return char, char.HumanoidRootPart, char:FindFirstChildOfClass("Humanoid")
end
return nil, nil, nil
end
local function sendNotification(title, message)
print("[scOP Master Engine]: " .. title .. " - " .. message)
end
local function resolveStealTarget(promptParent)
if not promptParent then return nil end
if promptParent:IsA("BasePart") then return promptParent end
if promptParent:IsA("Model") then
if promptParent.PrimaryPart then return promptParent.PrimaryPart end
return promptParent:FindFirstChildWhichIsA("BasePart", true)
end
if promptParent.Parent and promptParent.Parent:IsA("Model") then
return promptParent.Parent:FindFirstChildWhichIsA("BasePart", true)
end
return nil
end
local function humanDelay(minSec, maxSec)
task.wait(math.random(minSec * 100, maxSec * 100) / 100)
end
local function getDynamicSpeed()
local ping = 100
pcall(function()
local netStats = Stats:FindFirstChild("Network")
if netStats and netStats:FindFirstChild("ServerStatsItem") and netStats.ServerStatsItem:FindFirstChild("Data Ping") then
ping = netStats.ServerStatsItem["Data Ping"]:GetValue()
end
end)
local randomVariation = math.random(-2, 2)
if ping > 150 then
return math.clamp(16 + randomVariation, 14, 18)
elseif ping > 80 then
return math.clamp(18 + randomVariation, 16, 20)
else
return math.clamp(LOGICAL_SERVER_CONFIG.BASE_SPEED + randomVariation, 16, 22)
end
end
-- ====================================================================
-- [MISI 4] NATURAL PATHFINDING & MOVEMENT SYSTEM
-- ====================================================================
local function safePhysicalMovement(targetCFrame)
local char, root, humanoid = getCharacter()
if not root or not humanoid or humanoid.Health <= 0 then return end
root.AssemblyLinearVelocity = Vector3.zero
root.AssemblyAngularVelocity = Vector3.zero
if featuresState.SafeTween then
local path = PathfindingService:CreatePath({
AgentRadius = 2.5,
AgentHeight = 5,
AgentCanJump = true,
WaypointSpacing = 4
})
local success = pcall(function()
path:ComputeAsync(root.Position, targetCFrame.Position)
end)
if success and path.Status == Enum.PathStatus.Success then
local waypoints = path:GetWaypoints()
for _, waypoint in ipairs(waypoints) do
if humanoid.Health <= 0 then break end
humanoid.WalkSpeed = getDynamicSpeed()
humanoid:MoveTo(waypoint.Position)
if waypoint.Action == Enum.PathWaypointAction.Jump then
humanoid.Jump = true
end
local reached = false
local conn
conn = humanoid.MoveFinished:Connect(function()
reached = true
if conn then conn:Disconnect() end
end)
local startTick = tick()
while not reached and (tick() - startTick) < 2 do
if humanoid.Health <= 0 then break end
task.wait(0.05)
end
if conn then conn:Disconnect() end
end
else
humanoid.WalkSpeed = getDynamicSpeed()
humanoid:MoveTo(targetCFrame.Position)
task.wait(1.5)
end
humanoid.WalkSpeed = 16
root.AssemblyLinearVelocity = Vector3.zero
root.AssemblyAngularVelocity = Vector3.zero
else
root.CFrame = targetCFrame
end
end
-- ====================================================================
-- [MISI 5] USER INTERFACE & COMPONENT BUILDER SYSTEM
-- ====================================================================
