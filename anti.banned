toggleLowGraphics(val)
end)
CreateToggleButton("Auto Rejoin on Disconnect", featuresState.AutoRejoin, function(val)
featuresState.AutoRejoin = val
end)
CreateToggleButton("Anti-AFK Protection", featuresState.AntiAFK, function(val)
featuresState.AntiAFK = val
end)
table.insert(Connections, GuiService.ErrorMessageChanged:Connect(function()
if featuresState.AutoRejoin and rejoinAttempts < 3 then
rejoinAttempts = rejoinAttempts + 1
task.wait(2.5)
TeleportService:Teleport(game.PlaceId, LocalPlayer)
end
end))
table.insert(Connections, LocalPlayer.Idled:Connect(function()
if featuresState.AntiAFK then
VirtualUser:CaptureController()
VirtualUser:ClickButton1(Vector2.new(math.random(100, 500), math.random(100, 500)))
end
end))
local function ToggleUI()
isUiVisible = not isUiVisible
MainFrame.Visible = isUiVisible
end
table.insert(Connections, OpenBtn.MouseButton1Click:Connect(ToggleUI))
table.insert(Connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
if not gameProcessed and input.KeyCode == UI_TOGGLE_KEY then
ToggleUI()
end
end))
-- ====================================================================
-- [MISI 8] MASTER UNLOADER & CLEANUP PIPELINE
-- ====================================================================
getgenv().scOPCleanup = function()
if lowGraphicsConnection then
lowGraphicsConnection:Disconnect()
end
for part, mat in pairs(OriginalGraphics.Parts) do
if part and part.Parent then part.Material = mat end
end
for decal, trans in pairs(OriginalGraphics.Decals) do
if decal and decal.Parent then decal.Transparency = trans end
end
for _, conn in ipairs(Connections) do
if conn then conn:Disconnect() end
end
if ScreenGui then ScreenGui:Destroy() end
end
sendNotification("Loaded", "scOP Hub Filter Edition SIAP DIGUNAKAN!")
